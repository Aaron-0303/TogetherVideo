PORT=3000
SITE_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
TRUST_PROXY=false
DEFAULT_ROOM=ours
MAX_ROOM_USERS=2

# OpenList internal address used by TogetherVideo's backend.
OPENLIST_BASE_URL=http://openlist:5244
# Optional browser-reachable OpenList address. Used only if fs/get has no raw_url.
OPENLIST_PUBLIC_URL=
# Optional OpenList API token. Leave blank only when the mounted path is anonymously readable.
OPENLIST_TOKEN=
# Mount/folder that contains your shows, e.g. /QuarkTV/电视剧
OPENLIST_ROOT=/
OPENLIST_PATH_PASSWORD=
OPENLIST_TIMEOUT_MS=15000

DATA_FILE=/app/data/state.json
