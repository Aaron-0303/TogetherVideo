# Zero-touch deployment needs no environment variables.
# These are optional overrides for advanced deployments.
HOST=0.0.0.0
PORT=3000
OPENLIST_MANAGED=true

# Optional: override the first-login password (default: change-me).
# SITE_PASSWORD=
# Optional: if using an external OpenList instead of the bundled runtime.
# OPENLIST_MANAGED=false
# OPENLIST_BASE_URL=http://127.0.0.1:5244
# OPENLIST_ADMIN_PASSWORD=
# OPENLIST_TOKEN=
# OPENLIST_PUBLIC_URL=
# OPENLIST_ROOT=/QuarkTV

COOKIE_SECURE=false
TRUST_PROXY=true
DEFAULT_ROOM=ours
MAX_ROOM_USERS=2
OPENLIST_TIMEOUT_MS=15000
DATA_FILE=./data/state.json
SETTINGS_FILE=./data/settings.json
