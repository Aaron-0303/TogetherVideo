PORT=3000
SITE_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
TRUST_PROXY=false
DEFAULT_ROOM=ours
MAX_ROOM_USERS=2

# OpenList running on the same server.
OPENLIST_BASE_URL=http://127.0.0.1:5244
# Optional browser-reachable OpenList URL. Usually leave blank when fs/get returns raw_url.
OPENLIST_PUBLIC_URL=
# Optional OpenList API token. Leave blank only when the mounted path is anonymously readable.
OPENLIST_TOKEN=
# Mount/folder that contains your shows, e.g. /QuarkTV/电视剧
OPENLIST_ROOT=/
OPENLIST_PATH_PASSWORD=
OPENLIST_TIMEOUT_MS=15000

# Relative paths are resolved from the TogetherVideo project directory.
DATA_FILE=./data/state.json
